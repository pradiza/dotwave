# Configure in Vercel project environment variables, never in client code.
# Formspree form ID from https://formspree.io/f/ID, verified to deliver to dotwave.creative@gmail.com.
FORMSPREE_FORM_ID=
# Optional alternative when no Formspree form is configured:
RESEND_API_KEY=
# A sender verified in your Resend account (for example: dot.wave <hello@your-domain>)
CONTACT_FROM=
# Enable only when the Vercel plan supports custom events.
VERCEL_CUSTOM_EVENTS=false
